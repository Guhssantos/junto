# Mais fácil: rode `npm run setup`, que cria o .env perguntando estes valores.
# Ou copie para .env e preencha com os dados do seu projeto Supabase
# (Painel → Project Settings → API). Nunca coloque a service_role key aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-anon-ou-publishable-key

# ID do projeto EAS (gerado por `npx eas-cli init`) — necessário para push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=

# Opcional: endereço do site publicado (ex.: https://junto.pages.dev) para os links de
# convite gerados no app nativo. Na versão web o endereço do próprio site é usado.
# Sem ele, o app nativo gera junto://join/ABCD-1234 (abre só quem tem o app instalado).
EXPO_PUBLIC_INVITE_BASE_URL=
